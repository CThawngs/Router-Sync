{
  "name": "@routersync/mcp-server",
  "version": "0.1.0",
  "description": "Read-only MCP server for RouterSync inspection and querying",
  "license": "MIT",
  "author": "CThawngs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CThawngs/Router-Sync.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
