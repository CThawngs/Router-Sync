#!/usr/bin/env bash
# C23 V3: pre-push gate. Same four checks as before, but the test step now picks
# tests by branch diff (`pnpm test:related`) through the RAM gate, so a committed
# change is still covered. A RAM block (exit 3) warns and leaves the suite to CI.
set -u

echo "[prepush] lint"
if ! pnpm lint; then
  echo "[prepush] FAIL lint" >&2
  exit 1
fi

echo "[prepush] typecheck:changed"
if ! pnpm typecheck:changed; then
  echo "[prepush] FAIL typecheck:changed" >&2
  exit 1
fi

echo "[prepush] test:related"
pnpm test:related
test_status=$?
if [ "$test_status" -eq 3 ]; then
  echo "[prepush] WARN RAM gate blocked the related tests (exit 3)." >&2
  echo "[prepush] WARN CI will run the full suite; expect a higher chance of red." >&2
elif [ "$test_status" -ne 0 ]; then
  echo "[prepush] FAIL test:related (exit $test_status)" >&2
  exit "$test_status"
fi

echo "[prepush] validate-workflows"
if ! node tools/ci/validate-workflows.mjs; then
  echo "[prepush] FAIL validate-workflows" >&2
  exit 1
fi

# C30 K2.4: never push a non-fast-forward ref. The hook reads the pre-push
# stdin lines "<local ref> <local sha> <remote ref> <remote sha>" and rejects
# any update that is not a fast-forward (remote sha must be an ancestor of the
# new sha). A zero remote sha means the remote ref does not exist yet (create).
echo "[prepush] fast-forward check"
if ! node tools/guard/no-force-push.mjs; then
  echo "[prepush] FAIL fast-forward check (no force-push; rename or merge instead)" >&2
  exit 1
fi

echo "[prepush] OK"