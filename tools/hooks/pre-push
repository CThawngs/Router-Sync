#!/usr/bin/env bash
# C22 Z3: pre-push gate. Runs the repo's own checks so a push does not become a
# red CI run for something a local command would have caught.
#
# The RAM gate can answer 3 (free memory below the threshold). In that case the
# heavy part (test:changed) is skipped and the hook says so loudly, because the
# alternative — forcing the suite through — takes the owner's machine down.
set -u

echo "[prepush] lint"
if ! pnpm lint; then
  echo "[prepush] FAIL lint" >&2
  exit 1
fi

echo "[prepush] typecheck:changed"
if ! pnpm typecheck:changed; then
  echo "[prepush] FAIL typecheck:changed" >&2
  exit 1
fi

echo "[prepush] test:changed"
pnpm test:changed
test_status=$?
if [ "$test_status" -eq 3 ]; then
  echo "[prepush] WARN RAM gate blocked the tests (exit 3)." >&2
  echo "[prepush] WARN CI will run the full suite; expect a higher chance of red." >&2
elif [ "$test_status" -ne 0 ]; then
  echo "[prepush] FAIL test:changed (exit $test_status)" >&2
  exit "$test_status"
fi

echo "[prepush] validate-workflows"
if ! node tools/ci/validate-workflows.mjs; then
  echo "[prepush] FAIL validate-workflows" >&2
  exit 1
fi

echo "[prepush] OK"