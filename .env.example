# RouterSync Environment Configuration Example
# Copy this file to .env and configure appropriate local values.
# NEVER commit your .env file or real API keys to version control!

# Local Router Gateway Endpoints
OMNIROUTE_URL=http://localhost:30128
NINEROUTER_URL=http://localhost:20128

# Execution Policy
ROUTERSYNC_DRY_RUN=true
ROUTERSYNC_LOG_LEVEL=info

# Optional Provider API Keys (Read-only model listing; zero inference tokens)
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# NVIDIA_API_KEY=
