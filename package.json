{
  "name": "routersync",
  "version": "0.1.0",
  "description": "Keeps model lists and combos in sync across LLM routers, agent tools, and providers",
  "license": "MIT",
  "author": "CThawngs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CThawngs/Router-Sync.git"
  },
  "bugs": {
    "url": "https://github.com/CThawngs/Router-Sync/issues"
  },
  "homepage": "https://github.com/CThawngs/Router-Sync#readme",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "typecheck": "node tools/agent/heavy.mjs -- pnpm typecheck",
    "typecheck:changed": "node tools/agent/typecheck-changed.mjs",
    "lint": "node tools/guard/no-secrets.mjs && node tools/guard/no-personal-paths.mjs && node tools/guard/no-evidence-in-main.mjs",
    "guard:paths": "node tools/guard/no-personal-paths.mjs",
    "test": "node tools/agent/heavy.mjs -- pnpm test",
    "test:changed": "vitest run --changed",
    "test:branch": "node tools/agent/heavy.mjs -- pnpm test:branch",
    "test:file": "vitest run",
    "test:slow": "node tools/agent/heavy.mjs -- pnpm test:slow",
    "e2e": "node tools/agent/heavy.mjs -- pnpm e2e",
    "verify:release": "pnpm typecheck && pnpm lint && pnpm build && pnpm test && pnpm e2e",
    "build": "node tools/agent/heavy.mjs -- pnpm build",
    "routersync": "node packages/cli/dist/index.js",
    "ui:dev": "pnpm --filter @routersync/ui dev",
    "ui:build": "pnpm --filter @routersync/ui build",
    "ui:test": "pnpm --filter @routersync/ui test",
    "ui:preview": "pnpm --filter @routersync/ui preview",
    "prepush": "pnpm lint && pnpm typecheck:changed && node tools/agent/heavy.mjs -- pnpm test:related && node tools/ci/validate-workflows.mjs",
    "hooks:install": "node tools/ci/install-hooks.mjs",
    "test:related": "node tools/agent/heavy.mjs -- pnpm test:related"
  },
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@routersync/adapter-sdk": "workspace:*",
    "@routersync/core": "workspace:*",
    "@routersync/daemon": "workspace:*",
    "@types/node": "^26.6.5",
    "better-sqlite3": "13.0.3",
    "playwright-core": "^1.64.1",
    "typescript": "5.6.3",
    "vitest": "5.1.2"
  }
}
